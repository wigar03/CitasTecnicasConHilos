<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700.0" prefWidth="1200.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tecnoasistencia.controlador.CitaTecnicaController"
            style="-fx-background-color: #f8fafc; -fx-font-family: 'Segoe UI';">
    <top>
        <VBox spacing="4" style="-fx-background-color: #0f172a;">
            <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>
            <Label text="TecnoAsistencia Nicaragua S.A." style="-fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
            <Label text="Módulo de Gestión de Citas Técnicas" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;"/>
        </VBox>
    </top>
    <center>
        <HBox spacing="20">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <!-- Panel Izquierdo: Formulario CRUD de Citas -->
            <VBox prefWidth="380" minWidth="360" spacing="14" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-background-radius: 10; -fx-border-radius: 10;">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                <Label text="Formulario de Citas Técnicas" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
                <Label text="Los campos con * son obligatorios." style="-fx-text-fill: #64748b;"/>
                <Separator/>
                <GridPane hgap="10" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints minWidth="85"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="ID:" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtId" editable="false" promptText="Auto-generado" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Cliente: *" GridPane.rowIndex="1"/>
                    <ComboBox fx:id="cmbCliente" promptText="Seleccione un cliente" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Fecha: *" GridPane.rowIndex="2"/>
                    <DatePicker fx:id="dpFecha" promptText="Seleccione la fecha" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <Label text="Hora: *" GridPane.rowIndex="3"/>
                    <TextField fx:id="txtHora" promptText="HH:mm, ej. 09:30" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                    <Label text="Servicio: *" GridPane.rowIndex="4"/>
                    <TextField fx:id="txtServicio" promptText="Ej. Mantenimiento preventivo" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                    <Label text="Descripción: *" GridPane.rowIndex="5"/>
                    <TextField fx:id="txtDescripcion" promptText="Detalles técnicos del equipo o servicio" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                    <Label text="Estado: *" GridPane.rowIndex="6"/>
                    <ComboBox fx:id="cmbEstado" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                </GridPane>
                <Separator/>
                <HBox spacing="10">
                    <Button fx:id="btnGuardar" text="Guardar" onAction="#handleGuardar" maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Button fx:id="btnActualizar" text="Actualizar" onAction="#handleActualizar" disable="true" maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-background-color: #0284c7; -fx-text-fill: white;"/>
                </HBox>
                <HBox spacing="10">
                    <Button fx:id="btnEliminar" text="Eliminar" onAction="#handleEliminar" disable="true" maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-background-color: #ef4444; -fx-text-fill: white;"/>
                    <Button text="Limpiar" onAction="#limpiarFormulario" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
                <Label text="Sincronización: Al cambiar entre pestañas los clientes se actualizan automáticamente." wrapText="true" style="-fx-text-fill: #64748b; -fx-font-size: 11;"/>
            </VBox>

            <!-- Panel Derecho: Filtros y TableView de Citas -->
            <VBox spacing="14" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-background-radius: 10; -fx-border-radius: 10;">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <children>
                        <Label text="Filtros y Consulta de Citas" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblRecordatorio" text="Recordatorios" style="-fx-font-size: 11px; -fx-padding: 3 8 3 8; -fx-background-radius: 10; -fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-font-weight: bold;"/>
                    </children>
                </HBox>
                <!-- Resumen de Métricas Calculadas en Segundo Plano -->
                <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #f8fafc; -fx-padding: 8 12 8 12; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                    <children>
                        <Label fx:id="lblMetricaTotal" text="Total: 0" style="-fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-size: 11px;"/>
                        <Separator orientation="VERTICAL"/>
                        <Label fx:id="lblMetricaPendientes" text="Pendientes: 0" style="-fx-font-weight: bold; -fx-text-fill: #d97706; -fx-font-size: 11px;"/>
                        <Separator orientation="VERTICAL"/>
                        <Label fx:id="lblMetricaCompletadas" text="Completadas: 0" style="-fx-font-weight: bold; -fx-text-fill: #16a34a; -fx-font-size: 11px;"/>
                        <Separator orientation="VERTICAL"/>
                        <Label fx:id="lblMetricaCanceladas" text="Canceladas: 0" style="-fx-font-weight: bold; -fx-text-fill: #dc2626; -fx-font-size: 11px;"/>
                        <Separator orientation="VERTICAL"/>
                        <Label fx:id="lblMetricaEfectividad" text="Cumplimiento: 0%" style="-fx-font-weight: bold; -fx-text-fill: #2563eb; -fx-font-size: 11px;"/>
                    </children>
                </HBox>
                <FlowPane hgap="10" vgap="10" alignment="CENTER_LEFT">
                    <Label text="Estado:"/>
                    <ComboBox fx:id="cmbFiltroEstado" prefWidth="135"/>
                    <Label text="Fecha:"/>
                    <DatePicker fx:id="dpFiltroFecha" prefWidth="145"/>
                    <Button text="Limpiar filtros" onAction="#handleLimpiarFiltros"/>
                    <Button text="Recargar" onAction="#cargarDatos"/>
                </FlowPane>
                <Separator/>
                <TableView fx:id="tblCitas" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                        <TableColumn fx:id="colCliente" text="Cliente" prefWidth="170"/>
                        <TableColumn fx:id="colFecha" text="Fecha" prefWidth="95"/>
                        <TableColumn fx:id="colHora" text="Hora" prefWidth="65"/>
                        <TableColumn fx:id="colServicio" text="Servicio" prefWidth="150"/>
                        <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="200"/>
                        <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                </TableView>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <children>
                        <Label fx:id="lblContador" text="Citas mostradas: 0 de 0" style="-fx-text-fill: #64748b; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <ProgressIndicator fx:id="progresoCitas" prefWidth="18.0" prefHeight="18.0" visible="false" managed="false"/>
                        <Label fx:id="lblEstadoCitas" text="Listo" style="-fx-text-fill: #64748b; -fx-font-size: 11px;"/>
                    </children>
                </HBox>
            </VBox>

        </HBox>
    </center>
</BorderPane>